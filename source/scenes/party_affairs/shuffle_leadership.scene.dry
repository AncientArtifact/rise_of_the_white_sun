####################### adding advisors


@add_advisors
title: Add advisors
choose-if: n_advisors < 6
unavailable-subtitle: Maximum of 6 advisors.
go-to: advisor_menu

@advisor_menu
title: Add other advisors.
tags: center_advisor, left_advisor, right_advisor, center_left_advisor, whampoa_advisor, nonfactional_advisor
frequency: 1

- @add_tanyankai
- @add_sunfo
- @add_sunyatsen
- @add_liaozhongkai
- @add_mikhailborodin
- @add_soongchingling
