title: Province Tab
new-page: true
is-special: true
on-arrival: {!             
!}

<div id="province_tab">
  <header><strong id="province_tab_name">[+ current_province_name +]</strong></header>
  <p>Ruling Faction:</p>
  <p>Order:</p>
  <p>Supply Limit:</p>
  <button type="button" onclick="window.hideProvinceTab();">Close</button>
</div>
