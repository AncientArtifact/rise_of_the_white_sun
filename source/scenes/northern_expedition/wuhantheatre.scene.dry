title: Wuhan Theatre
new-page: true
is-card: true
card-image: img/portraits/WuPeifu.jpg
view-if: hengyang_done = 1 and wuhan_timer = 0
tags: northern_expedition
on-arrival: {!
Q.nra_strength = Math.round(Q.nra_strength * 10) / 10;
Q.bei_strength = Math.round(Q.bei_strength * 10) / 10;
Q.week_actions += 1;
Q.wuhan_timer += 3;
Q.bei_casualties = 0;
Q.nra_casualties = 0;
Q.nra_winchangsha = 0;
Q.nra_losechangsha = 0;
Q.nra_winyuezhou = 0;
Q.nra_loseyuezhou = 0;
Q.nra_winwuchang = 0;
Q.nra_losewuchang = 0;
!}

